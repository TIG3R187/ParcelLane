# Copy to .env.local. Placeholders only; never commit real secrets.
# On Vercel omit these localhost origins: the app uses Vercel's canonical domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Neon connection with sslmode=require (or verify-full); server only.
DATABASE_URL=
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=

# Private provisioning CLI only. Never upload the bootstrap password to Vercel.
ADMIN_BOOTSTRAP_EMAIL=
# Set your strong password HERE in .env.local (14–128 characters).
ADMIN_BOOTSTRAP_PASSWORD=

# Keep false for a customer preview. All BUSINESS_* values and legal approval
# must be present before public booking and enquiry endpoints open.
PUBLIC_REQUESTS_ENABLED=false
LEGAL_APPROVED=false
BUSINESS_NAME=
BUSINESS_EMAIL=
BUSINESS_PHONE=
BUSINESS_ADDRESS=
BUSINESS_COVERAGE=

# Optional Paystack TEST mode only. Live keys are rejected.
PAYSTACK_ENABLED=false
PAYSTACK_SECRET_KEY=
# Recommended signing secret, including the whsec_ prefix.
# Without this, legacy x-paystack-signature uses the test API secret.
PAYSTACK_WEBHOOK_SECRET=

# disabled | smtp. Disabled queues notifications without sending.
EMAIL_ADAPTER=disabled
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
